# Copy to .env and edit. Never commit .env. Existing environment variables win.

# Long random string. If empty, a new one is made per run and rooms do not survive a restart.
ZOOMODLE_MASTER_SECRET=

# Lecturer key. Leave empty to use (or create) ~/.zoomoodle/lecturer-key.txt (mode 600).
# The key is never printed. On Render set ZOOMODLE_LECTURER_KEY in the dashboard.
ZOOMODLE_LECTURER_KEY=
# ZOOMODLE_LECTURER_KEY_FILE=~/.zoomoodle/lecturer-key.txt

# Greeting: "שלום <name>, השבוע שבוע <week> בקורס <course>"
ZOOMODLE_LECTURER_NAME=טום יניב
ZOOMODLE_COURSE_NAME=מערכות נוירונים
ZOOMODLE_COURSE_WEEK=4

# University public ranges for the in-class network check (Ariel University, RIPE
# inetnum 192.114.48.0 - 192.114.57.255). Add 127.0.0.1/32 only to try it locally.
ZOOMODLE_CAMPUS_RANGES=192.114.48.0/21,192.114.56.0/23

# Peers allowed to supply a forwarded client address. CF-Connecting-IP is read only
# from loopback (cloudflared on this laptop); otherwise the right-most untrusted
# X-Forwarded-For hop is used. On Render add the private proxy ranges (see render.yaml).
ZOOMODLE_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Duplicate-name one-time codes. Without SMTP the code is shown on the lecturer
# dashboard as "מצב הדגמה – המייל לא נשלח". Use an app password, never your main one.
ZOOMODLE_SMTP_HOST=
ZOOMODLE_SMTP_PORT=587
ZOOMODLE_SMTP_USER=
ZOOMODLE_SMTP_PASSWORD=
ZOOMODLE_SMTP_FROM=
# Send every code to this one inbox (demo). Leave empty to use the roster address.
DEMO_EMAIL_OVERRIDE=

LLM_TIMEOUT_SECONDS=20
ZOOMODLE_AGENT_MAX_STEPS=8
