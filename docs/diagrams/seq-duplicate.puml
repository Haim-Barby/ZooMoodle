@startuml seq-duplicate
title Duplicate name – two phones in class claim "Dana Levi"

actor "Phone A" as A
actor "Phone B" as B
actor Lecturer as L
participant "HTTP API" as API
participant CheckinBook as CB

A -> API : join + live scan as "Dana"
API -> CB : submit_barcode(A)
CB --> API : A needs_area -> present
B -> API : join + live scan as "Dana"
API -> CB : submit_barcode(B)
CB -> CB : _resolve("Dana"): 2 verified in class
CB --> API : A, B -> repick
API --> A : popup "choose your real name"
API --> B : popup "choose your real name"
alt B picks another free name
  B -> API : repick("Yossi")
  API -> CB : repick(B, Yossi)
  CB --> API : B present (Yossi)
  A -> API : repick("Dana")
  CB --> API : A present (Dana)
else both pick "Dana" again
  B -> API : repick("Dana")
  API -> CB : repick(B, Dana)
  CB -> CB : already re-picked -> stage 3\nnew one-time code (6 digits, HMAC-stored)
  CB --> API : A, B -> lecturer_code
  API --> A : "the lecturer will come to you"
  API --> B : "the lecturer will come to you"
  L -> API : GET dashboard
  API --> L : conflict "Dana" + code 123456 (renews every 2 min)
  L -> A : walks to the real Dana
  L -> API : types 123456 on phone A\nPOST /name-code
  API -> CB : submit_code(A) [HMAC match, not expired, <3 tries]
  CB --> API : A present (owner), B rejected, code closed
  API --> A : "welcome Dana"
  API --> B : "not approved – start over"
  B -> API : start over: join + live scan as "Yossi"
  note over CB : wrong code -> refused (3 tries per phone)\n6 wrong tries or 2 min -> a new code
end
@enduml
