@startuml components
title ZooMoodle components

skinparam componentStyle rectangle
skinparam shadowing false

package "Student phone (browser)" {
  [Student page] as StudentUI
  [Camera / QR decoder] as Cam
}

package "Lecturer laptop" {
  [Lecturer page] as LecturerUI
  [Flickering barcode] as Barcode
  [Local presence helper] as Helper
}

package "ZooMoodle server" {
  [HTTP API] as API
  [Room store] as Store
  [KeyManager] as Keys
  [RoomRoster] as Roster
  [ScreenQrService] as ScreenQr
  [Network range] as Range
  [AttendanceService] as Attendance
  [ExportService] as Export
  [LessonAgent] as Agent
  [LLMClient] as Client
}

cloud "LLM provider" as Provider

StudentUI --> API : identify, barcode, poll,\ncomment, homework
LecturerUI --> API : room, roster, barcode,\nexport, agent, LLM test
Cam --> StudentUI
Barcode --> LecturerUI
StudentUI --> Helper : /prove
Helper --> API : observe
API --> Store
Store --> Keys
Store --> Roster
Store --> ScreenQr
Store --> Attendance
Attendance --> Range
API --> Export
API --> Agent
Agent --> Client
Client --> Provider : tool-calling HTTPS
@enduml
