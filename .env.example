# Copy to .env and edit. Never commit .env. The server reads .env itself
# and does not override variables that are already set.
#
#   python3 -m venv .venv
#   source .venv/bin/activate
#   pip install -r requirements.txt
#   cp .env.example .env

# Long random string. If empty, the process invents one and rooms stop
# verifying after a restart.
ZOOMODLE_MASTER_SECRET=

# Unlock token for the lecturer page. If empty, a random token is printed
# once at startup. This is not the LLM API key.
ZOOMODLE_LECTURER_TOKEN=

# Ariel University public egress, measured 2026-11-03 (192.114.52.1, AS378 IUCC).
# Source: RIPE inetnum 192.114.48.0 - 192.114.57.255, netname Ariel-segments,
# i.e. 192.114.48.0/21 and 192.114.56.0/23. The same registration also covers
# dorms and the campus VPN, so a match is only a supporting signal next to
# the ultrasonic token. Local Wi-Fi 10.6.0.0/20 is not usable through NAT
# or cloudflared: the server never sees 10.6.0.71. Empty disables the check.
ZOOMODLE_ALLOWED_SUBNETS=192.114.48.0/21,192.114.56.0/23

# Socket peers allowed to set CF-Connecting-IP or X-Forwarded-For.
# Default is loopback, because cloudflared on this laptop connects from there.
# Headers from any other peer are ignored so a client cannot spoof a campus IP.
ZOOMODLE_TRUSTED_PROXIES=127.0.0.1/32,::1/128

ZOOMODLE_TOKEN_WINDOW_SECONDS=5
ZOOMODLE_AGENT_MAX_STEPS=8

# LLM provider: openai, anthropic, gemini, xai, ollama, openai_compatible
# Leave the key empty and set it in the lecturer UI instead if you prefer.
# The UI keeps the key in server memory only. It is never written back here.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=8

# Default base URLs when LLM_BASE_URL is empty:
#   openai              https://api.openai.com/v1
#   xai                 https://api.x.ai/v1
#   ollama              http://127.0.0.1:11434/v1
#   openai_compatible   (required)
#   anthropic           https://api.anthropic.com
#   gemini              https://generativelanguage.googleapis.com/v1beta
# Ollama and openai_compatible may be used with an empty key.
# Example models (set the id your account actually has): gpt-4o-mini,
# claude-3-5-haiku-latest, gemini-2.0-flash, grok-2-latest, llama3.1
