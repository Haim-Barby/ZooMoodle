@startuml components
!pragma layout smetana
title ZooMoodle – components
skinparam componentStyle rectangle

package "Lecturer laptop (browser)" {
  [Lecturer page] as LP
  [Live barcode canvas] as LB
  [Join QR] as JQ
}
package "Student phone (browser)" {
  [Student page] as SP
  [Camera + jsQR] as CAM
}
cloud "HTTPS proxy\n(Render / cloudflared)" as PX
package "ZooMoodle server (FastAPI)" {
  [HTTP API] as API
  [LecturerAuth] as AUTH
  [Store / Room] as ST
  [RoomRoster] as RR
  [CheckinBook] as CB
  [ScreenQrService] as QR
  [net.client_ip] as NET
  [SessionBook] as SB
  [Mailer] as ML
  [ExportService] as EX
  [SummaryService + LessonAgent] as AG
}
cloud "SMTP server" as SMTP
cloud "LLM provider" as LLM

LP --> PX : X-Lecturer-Session
LB --> PX : GET barcode
JQ ..> SP : opens
CAM ..> LB : films
CAM --> SP : codes
SP --> PX : signed requests
PX --> API : + client IP header
API --> AUTH
API --> SB
API --> NET
API --> ST
ST --> RR
ST --> CB
CB --> QR
CB --> ML
ML --> SMTP
API --> EX
API --> AG
AG --> LLM
@enduml
