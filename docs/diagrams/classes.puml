@startuml classes
title Core classes

skinparam shadowing false
hide circle

class Room {
  id
  salt
  key
  transcript
}

class KeyManager {
  derive_room_key(salt)
}

class RoomRoster {
  import_csv()
  verify_email()
}

class ScreenQrService {
  current_frame()
  verify_sequence()
}

class NetworkRange {
  contains(peer)
}

class PresenceHelper {
  prove(challenge)
}

class AttendanceService {
  identify()
  finish()
}

class AnomalyDetector {
  apply(records)
}

class SeatZone {
  value
}

class Poll {
  question
  options
  answers
}

class Comment {
  text
}

class HomeworkSubmission {
  id
  text
}

class ExportService {
  to_csv()
  to_xlsx()
}

class AttentionAggregator {
  add_sample()
  by_zone()
}

class LLMClient {
  complete()
  test_connection()
}

class LessonAgent {
  run(task, snapshot)
}

class ToolRegistry {
  dispatch()
  produce_report()
}

class SummaryService {
  summarize()
}

class HomeworkReviewService {
  review()
}

KeyManager --> Room
RoomRoster --> Room
ScreenQrService --> Room
AttendanceService --> RoomRoster
AttendanceService --> ScreenQrService
AttendanceService --> PresenceHelper
PresenceHelper --> NetworkRange
AttendanceService --> AnomalyDetector
AttendanceService --> SeatZone
Room --> Poll
Room --> Comment
Room --> HomeworkSubmission
Room --> AttentionAggregator
ExportService --> AttendanceService
SummaryService --> LessonAgent
HomeworkReviewService --> LessonAgent
LessonAgent --> LLMClient
LessonAgent --> ToolRegistry
@enduml
