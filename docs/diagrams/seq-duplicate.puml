@startuml seq-duplicate
title Duplicate name – two phones in class claim "Dana Levi" (decided automatically)

actor "Phone A" as A
actor "Phone B" as B
participant "HTTP API" as API
participant CheckinBook as CB
participant Mailer as Mail
participant "Gmail\n(SMTP)" as Gmail

A -> API : join + live scan as "Dana"
API -> CB : submit_barcode(A)
CB --> API : A needs_area -> present
B -> API : join + live scan as "Dana"
API -> CB : submit_barcode(B)
CB -> CB : _resolve("Dana"): 2 verified in class
CB --> API : A, B -> repick
API --> A : popup "choose your real name"
API --> B : popup "choose your real name"
alt B picks another free name
  B -> API : repick("Yossi")
  API -> CB : repick(B, Yossi)
  CB --> API : B present (Yossi)
  A -> API : repick("Dana")
  CB --> API : A present (Dana)
else both pick "Dana" again
  B -> API : repick("Dana")
  API -> CB : repick(B, Dana)
  CB -> CB : already re-picked -> stage 3
  CB -> Mail : send_code(roster e-mail of Dana, 6 digits)
  Mail -> Gmail : SMTP (smtp.gmail.com, App Password)
  CB --> API : A, B -> email_code
  API --> A : "enter the code from your e-mail"
  API --> B : "enter the code from your e-mail"
  A -> API : email-code(123456)
  API -> CB : submit_code(A) [HMAC match, <5 min, <3 tries]
  CB --> API : A present, B rejected
  API --> B : "not approved – start over"
  note over CB : expiry or all tries used ->\nevery claim on "Dana" rejected
end
@enduml
