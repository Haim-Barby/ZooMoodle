@startuml classes
!pragma layout smetana
title ZooMoodle – classes
skinparam classAttributeIconSize 0
hide empty members

class Settings {
  lecturer_key
  campus_ranges
  trusted_proxies
  greeting()
}
class LecturerAuth {
  -digest: HMAC(key)
  sign_in(key): token
  check(token): bool
}
class Store {
  rooms
  create_room(title): Room
  add_poll() / answer_poll()
  add_comment() / add_question()
  add_homework()
  submit_homework()
  snapshot(room)
}
class Room {
  id, title, key, closed
  transcript, summary
}
class RoomRoster {
  entries
  replace_from_csv(csv)
  public_names()
}
class RosterEntry {
  id, given, family
  salt, verifier(HMAC email)
}
class CheckinBook {
  claims
  join(entry, mode, on_campus)
  submit_barcode(claim, codes, on_campus)
  choose_area(claim, zone)
  repick(claim, entry)
  decide(claim_id, action)
}
class Claim {
  id, entry_id, mode
  state, zone
  verified, repicked, owner
}
class ScreenQrService {
  issue(room_key, room_id)
  verify_sequence(codes)
  flicker_seed()
}
class SessionBook {
  issue(claim_id)
  verify(signature, nonce, time)
}
class "net" as Net <<module>> {
  client_ip(headers, peer, trusted)
  subnet_status(ip, ranges)
}
class Poll
class Comment
class Question
class HomeworkFile
class Submission {
  id, student_id
  filename, text
}
class HomeworkReviewService {
  review(snapshot, submission_id, audience)
}
class ToolRegistry <<read-only tools>> {
  get_poll_results()
  get_transcript_segment()
  list_comments()
  get_homework() / compare_submissions()
  produce_report()
}
abstract class BaseProvider <<Adapter>> {
  {abstract} complete(messages, tools)
}
class OpenAICompatibleProvider
class AnthropicProvider
class GeminiProvider
class SummaryService {
  summarize(snapshot)
}
class LessonAgent
class LLMClient
class ExportService {
  to_csv() / to_xlsx()
}

Store "1" *-- "*" Room
Room *-- RoomRoster
Room *-- CheckinBook
Room *-- ScreenQrService
Room *-- SessionBook
Room *-- "*" Poll
Room *-- "*" Comment
Room *-- "*" Question
Room *-- "*" HomeworkFile
Room *-- "*" Submission
RoomRoster *-- "*" RosterEntry
CheckinBook *-- "*" Claim
CheckinBook --> ScreenQrService
CheckinBook --> RoomRoster
Claim ..> RosterEntry : entry_id
SummaryService --> LessonAgent
HomeworkReviewService --> LessonAgent
LessonAgent --> LLMClient
LessonAgent --> ToolRegistry
LLMClient --> BaseProvider
BaseProvider <|-- OpenAICompatibleProvider
BaseProvider <|-- AnthropicProvider
BaseProvider <|-- GeminiProvider
HomeworkReviewService ..> Store : snapshot
SummaryService ..> Store : snapshot
ExportService ..> Claim
LecturerAuth ..> Settings
Net ..> Settings
@enduml
